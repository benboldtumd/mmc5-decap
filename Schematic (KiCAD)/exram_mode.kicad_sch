	(text "Question:\nWhy should we care about PPU /A13\nAT ALL when the CPU has control of\nExRAM address bus?\n\nConsider:\nExRAM can still be used as a nametable\nwhen ExRAM mode is set to CPU mode."
		(exclude_from_sim no)
		(at 217.424 68.834 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "166d341a-84da-4967-b7e0-1b627b825405")
	)
	(text "$5104 Register\nExRAM Mode"
		(exclude_from_sim no)
		(at 73.66 25.4 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
				(italic yes)
			)
		)
		(uuid "191e3ff8-d243-4edc-b474-29f55d2a614b")
	)
	(text "That doesn't make sense because\nwhat if you have a nametable\nassigned to ExRAM in $5105?\nIt needs ExRAM Ax coming from PPU.\n\nSignal A9 (+ExRAM Nametable Access)\nis VERY closeby but no obvious connection"
		(exclude_from_sim no)
		(at 351.028 59.944 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "32fbc851-3484-4b9f-ae77-b91d8c79cdf2")
	)
	(text "Syncs\nSL3 to M2"
		(exclude_from_sim no)
		(at 57.404 77.724 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "49e10bfb-4123-44e1-a7a0-1b62586780b4")
	)
	(text "TRUE when:\nExRAM is mode $1x, which gives\nCPU access but no PPU access,\n*OR* PPU is accessing NT or AT"
		(exclude_from_sim no)
		(at 351.282 44.704 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "54e51224-b69a-448f-860d-80e4376ca0d5")
	)
	(text "There appears to be a selectable\ndelay jumper, connected at BM6."
		(exclude_from_sim no)
		(at 145.034 65.278 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8a036508-b8ad-4c1f-85fc-ade1932bec3c")
	)
	(text "This is the write\nsignal for the \nExRAM itself."
		(exclude_from_sim no)
		(at 149.352 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a2016aa9-81dc-4e0b-8f3e-3f0868c3418f")
	)
	(text "Not sure about polarity; this\nmay be Mode %1x Access,\nand active low or high."
		(exclude_from_sim no)
		(at 193.294 96.774 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a6f6e873-b79d-4c7b-b9f0-a18dfea77c03")
	)
	(text "Consider:\nExRAM NEVER contains pattern tables\nand that should be related to\nhow PPU /A13 is being used here."
		(exclude_from_sim no)
		(at 213.868 54.864 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a72367ad-6b3e-4ac6-95d9-6d357bbb2f40")
	)
	(text "Tracks whether\n$5104 has been\nwritten since\nreset detection"
		(exclude_from_sim no)
		(at 75.438 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b419d2ef-015b-418b-96e8-0466f8a9cf3f")
	)
	(text "Appears to go\nnowhere but maybe\ngoes over BK82\nsomewhow."
		(exclude_from_sim no)
		(at 140.716 51.816 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b4f70cd5-831f-4ca3-a3e6-4c8b3cdb496f")
	)
	(text "Writing to ExRAM\nvia $5C00-5FFF\nin mode %10"
		(exclude_from_sim no)
		(at 129.286 131.826 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dd88cec3-5173-4af9-a890-65e264c8b32f")
	)
