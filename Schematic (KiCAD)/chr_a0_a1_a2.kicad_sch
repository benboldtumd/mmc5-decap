	(text "Theory:\n/OE C Active when:\n  - PPU is fetching sprite pattern data\n    or not rendering (ex. via PPUDATA).\n/OE B Active when:\n  - PPU is fetching background pattern data\n    in V-Split region.\n/OE A Active when:\n  - PPU is fetching background pattern data\n    everywhere else.\n"
		(exclude_from_sim no)
		(at 167.132 78.74 0)
		(effects
